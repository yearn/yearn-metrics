# Default decoded-event source. Set rpc only to use the legacy eth_getLogs path.
YEARN_DATA_EVENT_SOURCE=envio
YEARN_ENVIO_GRAPHQL_URL=

# Optional Envio ingestion tuning; defaults are 1,000 rows and 1,000,000 blocks.
YEARN_ENVIO_PAGE_SIZE=
YEARN_ENVIO_WINDOW_BLOCKS=

# Optional Yearn Kong endpoint for Envio vault and underlying-token metadata.
YEARN_KONG_GRAPHQL_URL=https://kong.yearn.fi/api/gql

# Required only when YEARN_DATA_EVENT_SOURCE=rpc. On-chain pricing fallbacks
# also read these. Multiple endpoints may be comma-separated for rotation:
# ETH_RPC_URL=https://a.example,https://b.example
ETH_RPC_URL=
POLYGON_RPC_URL=
BASE_RPC_URL=
ARB_RPC_URL=
KAT_RPC_URL=
# Optional Ethereum V2 source/ABI lookup.
ETHERSCAN_API_KEY=
