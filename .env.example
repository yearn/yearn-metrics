# Discovery and report ingestion (Envio by default; rpc keeps legacy acquisition).
YEARN_DATA_EVENT_SOURCE=envio
YEARN_ENVIO_GRAPHQL_URL=
# Optional metadata endpoint; defaults to https://kong.yearn.fi/api/gql
YEARN_KONG_GRAPHQL_URL=https://kong.yearn.fi/api/gql
# Optional tuning: YEARN_ENVIO_PAGE_SIZE=1000, YEARN_ENVIO_WINDOW_BLOCKS=1000000
# Required for the default Yearn Prices earnings provider. To use DefiLlama
# without this key, select price --source defillama or run --price-source defillama.
YEARN_PRICE_PROD_KEY=
# Optional override; defaults to https://prices.yearn.dev
YEARN_PRICE_PROD_BASE_URL=https://prices.yearn.dev
# RPC endpoints for volume, fee indexing, and on-chain pricing on default chains.
ETH_RPC_URL=
POLYGON_RPC_URL=
BASE_RPC_URL=
ARB_RPC_URL=
KAT_RPC_URL=
# Archive endpoints for explicitly selected historical chains.
OPTIMISM_RPC_URL=
FANTOM_RPC_URL=
