[Unit]
Description=Yearn Data nightly acquisition and publication
StartLimitIntervalSec=12h
StartLimitBurst=3

[Service]
Type=oneshot
WorkingDirectory=%h/raaaws/yearn-data
Environment=PYTHONPATH=%h/raaaws/yearn-data/src
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/raaaws/yearn-data/.scratch/nightly-venv/bin/python -m yearn_data.nightly --config %h/raaaws/yearn-data/ops/nightly-refresh.json --env %h/raaaws/yearn-data/.env --run
TimeoutStartSec=10h
TimeoutStopSec=90s
Restart=on-failure
RestartSec=5min
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
